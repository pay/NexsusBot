# NexsusBot — template konfigurasi
# Salin ke .env setelah konfigurasi tahap migrasi disetujui.
# Jangan masukkan kredensial asli ke Git.

# XMPP — wajib diisi untuk koneksi
NXSUS_XMPP_USER=
NXSUS_XMPP_HOST=
NXSUS_XMPP_PASSWORD=
NXSUS_XMPP_SERVER=
NXSUS_XMPP_PORT=5222
NXSUS_XMPP_RESOURCE=Nexus
NXSUS_NICK=NexsusBot
NXSUS_STATUS=Nexus Online
NXSUS_TLS=true
NXSUS_MSERVE=true
NXSUS_GETEXC=true
NXSUS_LANG=EN
NXSUS_ADMIN_JID=admin@localhost

# Groq — API key kosong berarti AI opsional tidak aktif
NXSUS_GROQ_API_KEY=
NXSUS_GROQ_ENDPOINT=https://api.groq.com/openai/v1
NXSUS_GROQ_MODEL=1
NXSUS_GROQ_TIMEOUT=60
NXSUS_AI_MAX_TOKENS=800
NXSUS_AI_TEMPERATURE=0.7
NXSUS_AI_PROMPT_CAP=1200
NXSUS_AI_RESULT_CAP=1500
NXSUS_AI_CHUNK_SIZE=800
NXSUS_AI_HISTORY_MAX_AGE=7
NXSUS_AI_ROOM_LOG_MAX=50
NXSUS_AI_ROOM_CTX_LIMIT=10
NXSUS_AI_ROOM_MSG_MAXLEN=300

# Logging
NXSUS_LOG_LEVEL=INFO
NXSUS_LOG_FILE_LEVEL=DEBUG
NXSUS_LOG_FILE=nexsus.log
NXSUS_LOG_CONSOLE=true
NXSUS_LOG_MAX_BYTES=2097152
NXSUS_LOG_BACKUP_COUNT=3

# Batas pesan/memori
NXSUS_LIMIT_INCOMING=2000
NXSUS_LIMIT_PRIVATE=2000
NXSUS_LIMIT_CHAT=2000
NXSUS_LIMIT_CHAT_LIST=100
NXSUS_LIMIT_MEMORY_MB=0
