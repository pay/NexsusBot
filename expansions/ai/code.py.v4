# NexsusBot Expansion — Ollama AI
# exp_name = "ai" # /code.py v.4.0

import urllib.request
import urllib.error
import json
import threading

OLLAMA_URL           = "http://localhost:11434/api/chat"
OLLAMA_MODEL_DEFAULT = "qwen2:0.5b"
OLLAMA_MODELS        = {
    "fast":  "qwen2:0.5b",
    "smart": "qwen2.5:3b",
}
HISTORY_MAX_DEFAULT  = 10
HISTORY_OPTIONS      = (5, 10, 20)
TIMEOUT              = 45

SYSTEM_PROMPT = (
    "Nama kamu adalah Nexsus, asisten bot XMPP yang dibuat oleh paijo. "
    "Kamu helpful, cerdas, dan ramah. "
    "Jawab dalam bahasa yang sama dengan pertanyaan pengguna. "
    "Jawaban ringkas namun lengkap, maksimal 3-4 kalimat. "
    "Gunakan bahasa santai dan friendly, boleh pakai emoji sesekali. "
    "Tolak dengan sopan jika ada pertanyaan mengandung konten negatif, sara, atau berbahaya. "
    "Kamu berada di grup chat XMPP komunitas Indonesia. "
    "Alamat grup: indonesia@conference.conversations.im. "
    "Bahasa yang digunakan campur: Indonesia, Jawa/daerah, dan Inggris — ikuti bahasa pengguna. "
    "Topik yang sering dibahas: teknologi, Linux, server, XMPP, bot, programming, dan ngobrol santai. "
    "Rules grup: dilarang spam, jaga sopan santun, no SARA, no konten berbahaya. "
    "Tegur dengan sopan jika ada yang melanggar rules. "
    "Member aktif di grup: i_duthe, bedjo, heper, 33777, IndonesianLad, Irfan, Kitsune, "
    "ivy, kujawek, mrdoctorwho, Nawan, potential suicide, Rio, tfox, uira.pro, win., "
    "paijo, MBG, RI.21#menlu, SPPG. "
    "paijo adalah owner dan pembuat bot ini. "
    "Nexsus adalah nama kamu sendiri (bot). "
    "Jika ada yang bertanya tentang grup, kamu bisa jelaskan info di atas. "
    "Jika ada yang bertanya siapa member aktif, sebutkan daftar di atas. "
)


class expansion_temp(expansion):

    def __init__(self, name):
        expansion.__init__(self, name)
        self._ai_enabled     = True       # global fallback
        self._disabled_rooms = set()      # room JID yang di-off-kan
        self._current_model  = OLLAMA_MODEL_DEFAULT
        self._history_max    = HISTORY_MAX_DEFAULT
        # { user_id: [ {role, content}, ... ] }
        self._history        = {}

    # ── helpers ──────────────────────────────────────────────────────────────

    def _get_label(self):
        for label, model in OLLAMA_MODELS.items():
            if model == self._current_model:
                return label
        return "custom"

    def _get_user_id(self, source):
        return source[2] if source[2] else source[1]

    def _is_pm(self, stype):
        return stype == sBase[0]  # "chat"

    def _is_room(self, stype):
        return stype == sBase[1]  # "groupchat"

    def _check_pm_access(self, source):
        """Cek apakah user boleh PM — harus ada di Galist (roster)."""
        user_jid = source[1].lower()
        return Galist.get(user_jid, 0) >= 2

    def _is_ai_on(self, stype, source):
        """Cek apakah AI aktif untuk context ini."""
        if not self._ai_enabled:
            return False
        if self._is_pm(stype):
            return self._check_pm_access(source)
        if self._is_room(stype):
            return source[1] not in self._disabled_rooms
        return True

    # ── history ───────────────────────────────────────────────────────────────

    def _get_history(self, user_id):
        return self._history.setdefault(user_id, [])

    def _add_history(self, user_id, role, content):
        history = self._get_history(user_id)
        history.append({"role": role, "content": content})
        max_msgs = self._history_max * 2
        if len(history) > max_msgs:
            self._history[user_id] = history[-max_msgs:]

    def _reset_history(self, user_id):
        self._history[user_id] = []

    def _reset_all_history(self):
        self._history = {}

    # ── ollama ────────────────────────────────────────────────────────────────

    def _call_ollama(self, user_id, prompt):
        history  = self._get_history(user_id)
        messages = [{"role": "system", "content": SYSTEM_PROMPT}]
        messages += history
        messages.append({"role": "user", "content": prompt})

        payload = json.dumps({
            "model":    self._current_model,
            "messages": messages,
            "stream":   False,
        }).encode("utf-8")

        req = urllib.request.Request(
            OLLAMA_URL,
            data=payload,
            headers={"Content-Type": "application/json"},
            method="POST",
        )
        try:
            with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
                data = json.loads(resp.read().decode("utf-8"))
            result = data["message"]["content"].strip()
            if len(result) > 1500:
                result = result[:1497] + "..."
            self._add_history(user_id, "user",      prompt)
            self._add_history(user_id, "assistant", result)
            return result, None
        except urllib.error.URLError as e:
            return None, "Tidak bisa terhubung ke Ollama: %s" % e.reason
        except Exception as e:
            return None, "Error: %s" % str(e)

    def _ai_worker(self, user_id, prompt, stype, source, disp):
        result, error = self._call_ollama(user_id, prompt)
        if error:
            Answer("❌ %s" % error, stype, source, disp)
        else:
            Answer("🤖 %s" % result, stype, source, disp)

    # ── /ai ──────────────────────────────────────────────────────────────────

    def command_ai(self, stype, source, body, disp):
        """/ai <pertanyaan> | reset — Tanya AI"""

        # cek PM access
        if self._is_pm(stype) and not self._check_pm_access(source):
            return  # diam saja, user tidak di roster

        # cek room off
        if self._is_room(stype) and source[1] in self._disabled_rooms:
            return  # diam saja, AI off di room ini

        # cek global
        if not self._ai_enabled:
            Answer("🔴 Fitur AI sedang dinonaktifkan.", stype, source, disp)
            return

        user_id = self._get_user_id(source)
        cmd     = (body or "").strip()

        # /ai reset
        if cmd.lower() == "reset":
            self._reset_history(user_id)
            Answer("🗑️ History percakapanmu telah dihapus.", stype, source, disp)
            return

        if not cmd:
            history_count = len(self._get_history(user_id)) // 2
            room_status   = ""
            if self._is_room(stype):
                room_status = "\nRoom ini: %s" % (
                    "🔴 OFF" if source[1] in self._disabled_rooms else "🟢 ON"
                )
            Answer(
                "🤖 Ollama AI siap! (%s — %s)\n"
                "History kamu: %d/%d pesan%s\n"
                "Gunakan: /ai <pertanyaan>\n"
                "Reset history: /ai reset" % (
                    self._get_label(),
                    self._current_model,
                    history_count,
                    self._history_max,
                    room_status,
                ),
                stype, source, disp
            )
            return

        Answer("🦙 Sedang berpikir... (%s)" % self._current_model, stype, source, disp)
        t = threading.Thread(
            target=self._ai_worker,
            args=(user_id, cmd, stype, source, disp),
            daemon=True,
        )
        t.start()

    # ── /aiset ───────────────────────────────────────────────────────────────

    def command_aiset(self, stype, source, body, disp):
        """/aiset on|off [global]|model|history|reset|info — Kelola AI"""
        args = (body or "").strip().split()
        cmd  = args[0].lower() if args else "info"
        sub  = args[1].lower() if len(args) > 1 else ""

        # ── on / off ─────────────────────────────────────────────────────────
        if cmd in ("on", "off"):
            is_on = cmd == "on"

            if sub == "global":
                self._ai_enabled = is_on
                if is_on:
                    # global on → clear semua disabled rooms juga
                    self._disabled_rooms.clear()
                    Answer("🟢 AI diaktifkan secara global (semua room).", stype, source, disp)
                else:
                    Answer("🔴 AI dinonaktifkan secara global (semua room).", stype, source, disp)

            elif self._is_room(stype):
                room = source[1]
                if is_on:
                    self._disabled_rooms.discard(room)
                    Answer("🟢 AI diaktifkan di room ini.", stype, source, disp)
                else:
                    self._disabled_rooms.add(room)
                    Answer("🔴 AI dinonaktifkan di room ini.", stype, source, disp)

            else:
                # dari PM — hanya bisa global
                self._ai_enabled = is_on
                Answer(
                    "%s AI %s (global)." % (
                        "🟢" if is_on else "🔴",
                        "diaktifkan" if is_on else "dinonaktifkan",
                    ),
                    stype, source, disp
                )

        # ── model ─────────────────────────────────────────────────────────────
        elif cmd == "model":
            if not sub:
                Answer(
                    "🤖 Model saat ini: %s (%s)\n"
                    "Ganti: /aiset model fast|smart\n"
                    "  fast  → %s\n"
                    "  smart → %s" % (
                        self._get_label(),
                        self._current_model,
                        OLLAMA_MODELS["fast"],
                        OLLAMA_MODELS["smart"],
                    ),
                    stype, source, disp
                )
            elif sub in OLLAMA_MODELS:
                self._current_model = OLLAMA_MODELS[sub]
                Answer(
                    "✅ Model diganti ke: %s (%s)" % (sub, self._current_model),
                    stype, source, disp
                )
            else:
                Answer(
                    "❌ Pilihan: fast (%s) | smart (%s)" % (
                        OLLAMA_MODELS["fast"],
                        OLLAMA_MODELS["smart"],
                    ),
                    stype, source, disp
                )

        # ── history ───────────────────────────────────────────────────────────
        elif cmd == "history":
            if not sub:
                Answer(
                    "📝 Max history: %d pesan/user\n"
                    "Ganti: /aiset history 5|10|20" % self._history_max,
                    stype, source, disp
                )
            else:
                try:
                    val = int(sub)
                    if val in HISTORY_OPTIONS:
                        self._history_max = val
                        Answer("✅ Max history diubah ke %d pesan/user." % val, stype, source, disp)
                    else:
                        Answer("❌ Pilihan: 5 | 10 | 20", stype, source, disp)
                except ValueError:
                    Answer("❌ Gunakan angka: 5 | 10 | 20", stype, source, disp)

        # ── reset ─────────────────────────────────────────────────────────────
        elif cmd == "reset":
            if sub == "all":
                total = len(self._history)
                self._reset_all_history()
                Answer("🗑️ History semua user dihapus. (%d user)" % total, stype, source, disp)
            else:
                Answer("Gunakan: /aiset reset all", stype, source, disp)

        # ── info ──────────────────────────────────────────────────────────────
        elif cmd == "info":
            status       = "🟢 ON" if self._ai_enabled else "🔴 OFF"
            total_users  = len(self._history)
            total_msgs   = sum(len(v) for v in self._history.values()) // 2
            disabled_str = (
                "\n".join("  - %s" % r for r in sorted(self._disabled_rooms))
                if self._disabled_rooms else "  (tidak ada)"
            )
            room_status = ""
            if self._is_room(stype):
                room_status = "\nRoom ini : %s" % (
                    "🔴 OFF" if source[1] in self._disabled_rooms else "🟢 ON"
                )
            Answer(
                "🤖 AI Info\n"
                "Global  : %s\n"
                "Model   : %s (%s)%s\n"
                "History : %d pesan/user (max)\n"
                "Users   : %d aktif (%d total pesan)\n"
                "Host    : %s\n\n"
                "Room OFF:\n%s\n\n"
                "Models:\n"
                "  fast  → %s\n"
                "  smart → %s\n\n"
                "Commands:\n"
                "/ai <pertanyaan>\n"
                "/ai reset\n"
                "/aiset on|off              (room ini)\n"
                "/aiset on|off global       (semua room)\n"
                "/aiset model fast|smart\n"
                "/aiset history 5|10|20\n"
                "/aiset reset all\n"
                "/aiset info" % (
                    status,
                    self._get_label(),
                    self._current_model,
                    room_status,
                    self._history_max,
                    total_users,
                    total_msgs,
                    OLLAMA_URL,
                    disabled_str,
                    OLLAMA_MODELS["fast"],
                    OLLAMA_MODELS["smart"],
                ),
                stype, source, disp
            )

        else:
            Answer(
                "Usage: /aiset on|off [global] | model fast|smart | "
                "history 5|10|20 | reset all | info",
                stype, source, disp
            )

    commands = (
        (command_ai,    "ai",    1,),
        (command_aiset, "aiset", 7,),
    )