class expansion_temp(expansion):

    def __init__(self, name):
        expansion.__init__(self, name)
        self._ai_enabled     = False
        self._disabled_rooms = set()
        self._current_model  = OLLAMA_MODEL_DEFAULT
        self._history        = {}
        self._ulimit         = {}
        self._lock           = threading.Lock()
        self._dirty          = False   # flag: ada perubahan history yg belum disave
        # load history & ulimit dari disk
        self._load_history()
        self._load_ulimit()
        # cek Ollama saat boot (non-blocking)
        t = threading.Thread(target=self._boot_check, daemon=True)
        t.start()
        # flush history ke disk secara berkala
        t2 = threading.Thread(target=self._flush_loop, daemon=True)
        t2.start()

    # -- boot check -------------------------------------------------------

    def _ping_ollama(self):
        """Ping Ollama /api/tags, return True jika running."""
        try:
            req = urllib.request.Request(
                OLLAMA_TAGS_URL,
                headers={"Content-Type": "application/json"},
                method="GET",
            )
            with urllib.request.urlopen(req, timeout=OLLAMA_PING_TIMEOUT) as resp:
                return resp.status == 200
        except Exception:
            return False

    def _boot_check(self):
        """Jalankan saat boot: aktifkan AI jika Ollama running."""
        if self._ping_ollama():
            self._ai_enabled = True
            print("[nexsus:ai] Ollama running — AI diaktifkan (%s)" % self._current_model)
        else:
            print("[nexsus:ai] Ollama tidak running — AI dinonaktifkan")

    # -- persistensi history ---------------------------------------------

    def _ensure_dir(self):
        import os
        os.makedirs(HISTORY_DIR, exist_ok=True)

    def _load_history(self):
        """Load history dari disk saat boot, buang entry > HISTORY_MAX_AGE hari."""
        import os, time
        if not os.path.exists(HISTORY_FILE):
            return
        try:
            with open(HISTORY_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
            cutoff = time.time() - HISTORY_MAX_AGE * 86400
            cleaned = {}
            for key, entries in data.items():
                # filter entry yang punya timestamp >= cutoff
                kept = [e for e in entries if e.get("ts", 0) >= cutoff]
                if kept:
                    cleaned[key] = kept
            self._history = cleaned
            print("[nexsus:ai] History dimuat: %d key" % len(self._history))
        except Exception as e:
            print("[nexsus:ai] Gagal load history: %s" % e)

    def _load_ulimit(self):
        """Load ulimit dari disk."""
        import os
        if not os.path.exists(ULIMIT_FILE):
            return
        try:
            with open(ULIMIT_FILE, "r", encoding="utf-8") as f:
                self._ulimit = json.load(f)
            print("[nexsus:ai] Ulimit dimuat: %d entry" % len(self._ulimit))
        except Exception as e:
            print("[nexsus:ai] Gagal load ulimit: %s" % e)

    def _save_history(self):
        """Simpan history ke disk (atomic write via tempfile)."""
        import os, tempfile
        try:
            self._ensure_dir()
            with self._lock:
                data = {k: list(v) for k, v in self._history.items()}
            tmp = HISTORY_FILE + ".tmp"
            with open(tmp, "w", encoding="utf-8") as f:
                json.dump(data, f, ensure_ascii=False, separators=(",", ":"))
            os.replace(tmp, HISTORY_FILE)
            self._dirty = False
        except Exception as e:
            print("[nexsus:ai] Gagal save history: %s" % e)

    def _save_ulimit(self):
        """Simpan ulimit ke disk."""
        import os, tempfile
        try:
            self._ensure_dir()
            with self._lock:
                data = dict(self._ulimit)
            tmp = ULIMIT_FILE + ".tmp"
            with open(tmp, "w", encoding="utf-8") as f:
                json.dump(data, f, ensure_ascii=False, separators=(",", ":"))
            os.replace(tmp, ULIMIT_FILE)
        except Exception as e:
            print("[nexsus:ai] Gagal save ulimit: %s" % e)

    def _flush_loop(self):
        """Daemon thread: save history ke disk tiap HISTORY_FLUSH_INTERVAL detik."""
        import time
        while True:
            time.sleep(HISTORY_FLUSH_INTERVAL)
            if self._dirty:
                self._save_history()

    # -- room context -----------------------------------------------------

    def _get_room_key(self, room_jid):
        """Key untuk history room (shared, bukan per-user)."""
        return "room:" + room_jid

    def _get_room_limit(self, room_jid):
        """Limit history room — pakai key room di ulimit atau default 50."""
        key = self._get_room_key(room_jid)
        return self._ulimit.get(key, 50)

    # -- helpers ----------------------------------------------------------

    def _get_label(self):
        for label, model in OLLAMA_MODELS.items():
            if model == self._current_model:
                return label
        return "custom"

    def _is_pm(self, stype):
        return stype == sBase[0]

    def _is_room(self, stype):
        return stype == sBase[1]

    def _get_user_id(self, source):
        return source[2] if source[2] else source[1]

    def _get_access(self, stype, source):
        if self._is_pm(stype):
            return Galist.get(source[1].lower(), 2)
        return get_access(source[1], source[2])

    def _get_history_limit(self, stype, source):
        user_id = self._get_user_id(source)
        if user_id in self._ulimit:
            return self._ulimit[user_id]
        if self._is_pm(stype):
            jid = source[1].lower()
            if jid != user_id and jid in self._ulimit:
                return self._ulimit[jid]
        access = self._get_access(stype, source)
        for min_access, limit in HISTORY_BY_ACCESS:
            if access >= min_access:
                return limit
        return 0

    def _check_pm_access(self, source):
        return Galist.get(source[1].lower(), 0) >= 7

    def _is_ai_allowed(self, stype, source):
        if not self._ai_enabled:
            return False
        if self._is_pm(stype):
            return self._check_pm_access(source)
        if self._is_room(stype):
            return source[1] not in self._disabled_rooms
        return True

    # -- history ----------------------------------------------------------

    def _get_history(self, user_id):
        return self._history.setdefault(user_id, [])

    def _add_history(self, user_id, role, content, limit):
        import time
        with self._lock:
            history = self._get_history(user_id)
            history.append({"role": role, "content": content, "ts": time.time()})
            if limit < 9999:
                max_msgs = limit * 2
                if len(history) > max_msgs:
                    self._history[user_id] = history[-max_msgs:]
        self._dirty = True

    def _reset_history(self, user_id):
        with self._lock:
            self._history[user_id] = []
        self._dirty = True

    def _reset_all_history(self):
        with self._lock:
            self._history = {}
        self._dirty = True

    # -- resolve nick/jid untuk ulimit ------------------------------------

    def _resolve_target(self, target, source):
        room = source[1]
        if room in Chats:
            user = Chats[room].get_user(target)
            if user and user.source:
                return user.source.lower(), target
        for conf_str, conf in Chats.items():
            user = conf.get_user(target)
            if user and user.source:
                return user.source.lower(), target
        return target.lower(), target

    # -- ollama -----------------------------------------------------------

    def _call_ollama(self, user_id, prompt, limit):
        # batasi panjang prompt agar tidak OOM di Termux
        if len(prompt) > 800:
            prompt = prompt[:800] + "..."

        with self._lock:
            history = list(self._get_history(user_id))
        # strip field "ts" — Ollama hanya butuh role + content
        clean_history = [{"role": e["role"], "content": e["content"]} for e in history]
        messages = [{"role": "system", "content": SYSTEM_PROMPT}]
        messages += clean_history
        messages.append({"role": "user", "content": prompt})

        payload = json.dumps({
            "model":    self._current_model,
            "messages": messages,
            "stream":   False,
            "options": {
                "num_predict":    -1,     # unlimited — model selesai natural, chunking via _send_chunked
                "temperature":    0.7,
                "num_ctx":        2048,  # dinaikkan untuk prompt panjang
                "num_thread":     5,
                "repeat_penalty": 1.1,
            },
        }).encode("utf-8")

        req = urllib.request.Request(
            OLLAMA_URL,
            data=payload,
            headers={"Content-Type": "application/json"},
            method="POST",
        )
        try:
            with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
                data = json.loads(resp.read().decode("utf-8"))
            result = data["message"]["content"].strip()
            # sanitasi karakter non-printable yang bisa crash XMPP
            result = "".join(c for c in result if c >= " " or c in "\n\t")
            if len(result) > 1500:
                result = result[:1497] + "..."
            if not result:
                return None, "Model tidak menghasilkan respons."
            self._add_history(user_id, "user",      prompt, limit)
            self._add_history(user_id, "assistant", result, limit)
            return result, None
        except MemoryError:
            return None, "Memory tidak cukup untuk model ini. Coba ganti ke model fast."
        except urllib.error.URLError as e:
            return None, "Tidak bisa terhubung ke Ollama: %s" % e.reason
        except Exception as e:
            return None, "Error: %s" % str(e)

    def _send_chunked(self, text, stype, source, disp):
        """Kirim teks panjang dalam beberapa bagian dengan penanda (1/N), (2/N), dst."""
        import time
        if len(text) <= CHUNK_SIZE:
            Answer(text, stype, source, disp)
            return
        # pecah di batas kata agar tidak putus di tengah kata
        chunks = []
        remaining = text
        while remaining:
            if len(remaining) <= CHUNK_SIZE:
                chunks.append(remaining)
                break
            # cari posisi potong: spasi/newline terdekat sebelum CHUNK_SIZE
            cut = remaining.rfind(" ", 0, CHUNK_SIZE)
            if cut == -1:
                cut = remaining.rfind("\n", 0, CHUNK_SIZE)
            if cut == -1:
                cut = CHUNK_SIZE
            chunks.append(remaining[:cut].rstrip())
            remaining = remaining[cut:].lstrip()
        total = len(chunks)
        for i, chunk in enumerate(chunks, 1):
            label = "(%d/%d) " % (i, total) if total > 1 else ""
            Answer("%s%s" % (label, chunk), stype, source, disp)
            if i < total:
                time.sleep(0.5)

    def _ai_worker(self, user_id, prompt, limit, stype, source, disp,
                   room_key=None, nick=None):
        """
        room_key : jika tidak None, history disimpan di room shared key
        nick     : nama pengirim untuk prefix di room history
        """
        history_key = room_key if room_key else user_id
        # prefix nick di prompt jika mode room
        tagged_prompt = ("[%s]: %s" % (nick, prompt)) if nick else prompt
        result, error = self._call_ollama(history_key, tagged_prompt, limit)
        if error:
            Answer("[Nexsus] %s" % error, stype, source, disp)
        else:
            self._send_chunked("[Nexsus] %s" % result, stype, source, disp)

    # -- /ai --------------------------------------------------------------

    def command_ai(self, stype, source, body, disp):
        """/ai <pertanyaan> | reset"""
        if self._is_pm(stype) and not self._check_pm_access(source):
            return
        if self._is_room(stype) and source[1] in self._disabled_rooms:
            return
        if not self._ai_enabled:
            Answer("AI sedang dinonaktifkan.", stype, source, disp)
            return

        user_id = self._get_user_id(source)
        limit   = self._get_history_limit(stype, source)
        cmd     = (body or "").strip()

        if cmd.lower() == "reset":
            self._reset_history(user_id)
            Answer("History percakapanmu telah dihapus.", stype, source, disp)
            return

        if not cmd:
            history_count = len(self._get_history(user_id)) // 2
            limit_str     = "unlimited" if limit >= 9999 else str(limit)
            override_str  = " (custom)" if user_id in self._ulimit else " (auto)"
            room_str      = ""
            if self._is_room(stype):
                room_str = "\nRoom ini : %s" % (
                    "OFF" if source[1] in self._disabled_rooms else "ON"
                )
            Answer(
                "[Nexsus] Ollama AI siap! (%s — %s)\n"
                "History : %d/%s pesan%s%s\n"
                "Gunakan : ai <pertanyaan>\n"
                "Reset   : ai reset" % (
                    self._get_label(),
                    self._current_model,
                    history_count,
                    limit_str,
                    override_str,
                    room_str,
                ),
                stype, source, disp
            )
            return

        Answer(WAITING_MSG % AI_VERSION, stype, source, disp)
        t = threading.Thread(
            target=self._ai_worker,
            args=(user_id, cmd, limit, stype, source, disp),
            daemon=True,
        )
        t.start()

    # -- mention handler (01eh) -------------------------------------------

    def ai_01eh(self, stanza, isConf, stype, source, body, isToBs, disp):
        """Handle mention: aibot: <pertanyaan>"""
        # hanya proses mention di room
        if not isToBs or not isConf:
            return
        # cek room off
        if source[1] in self._disabled_rooms:
            return
        # cek global
        if not self._ai_enabled:
            return
        # abaikan body kosong
        prompt = (body or "").strip()
        if not prompt:
            return
        # abaikan jika command valid (sudah dihandle command_ai)
        first_word = prompt.split()[0].lower()
        if first_word in ("ai", "aiset"):
            return

        user_id  = self._get_user_id(source)
        nick     = source[2] if source[2] else user_id
        room_jid = source[1]
        room_key = self._get_room_key(room_jid)
        limit    = self._get_room_limit(room_jid)

        Answer(WAITING_MSG % AI_VERSION, stype, source, disp)
        t = threading.Thread(
            target=self._ai_worker,
            args=(user_id, prompt, limit, stype, source, disp),
            kwargs={"room_key": room_key, "nick": nick},
            daemon=True,
        )
        t.start()

    # -- /aiset -----------------------------------------------------------

    def command_aiset(self, stype, source, body, disp):
        """/aiset on|off [global]|model|ulimit|reset|info"""
        args = (body or "").strip().split()
        cmd  = args[0].lower() if args else "info"
        sub  = args[1].lower() if len(args) > 1 else ""

        # -- on / off -----------------------------------------------------
        if cmd in ("on", "off"):
            is_on = cmd == "on"
            if sub == "global":
                self._ai_enabled = is_on
                if is_on:
                    self._disabled_rooms.clear()
                Answer(
                    "AI %s (global)." % (
                        "diaktifkan semua room" if is_on else "dinonaktifkan semua room"
                    ),
                    stype, source, disp
                )
            elif self._is_room(stype):
                room = source[1]
                if is_on:
                    self._disabled_rooms.discard(room)
                    Answer("AI diaktifkan di room ini.", stype, source, disp)
                else:
                    self._disabled_rooms.add(room)
                    Answer("AI dinonaktifkan di room ini.", stype, source, disp)
            else:
                self._ai_enabled = is_on
                Answer(
                    "AI %s (global)." % ("diaktifkan" if is_on else "dinonaktifkan"),
                    stype, source, disp
                )

        # -- model --------------------------------------------------------
        elif cmd == "model":
            if not sub:
                Answer(
                    "Model saat ini: %s (%s)\n"
                    "Ganti: /aiset model fast|smart\n"
                    "  fast  -> %s\n"
                    "  smart -> %s" % (
                        self._get_label(),
                        self._current_model,
                        OLLAMA_MODELS["fast"],
                        OLLAMA_MODELS["smart"],
                    ),
                    stype, source, disp
                )
            elif sub in OLLAMA_MODELS:
                self._current_model = OLLAMA_MODELS[sub]
                Answer(
                    "Model diganti ke: %s (%s)" % (sub, self._current_model),
                    stype, source, disp
                )
            else:
                Answer(
                    "Pilihan: fast (%s) | smart (%s)" % (
                        OLLAMA_MODELS["fast"],
                        OLLAMA_MODELS["smart"],
                    ),
                    stype, source, disp
                )

        # -- ulimit -------------------------------------------------------
        elif cmd == "ulimit":
            if sub == "list":
                if not self._ulimit:
                    Answer("Tidak ada custom limit.", stype, source, disp)
                else:
                    lines = ["Custom history limit:"]
                    for uid, lim in sorted(self._ulimit.items()):
                        lim_str = "unlimited" if lim >= 9999 else str(lim)
                        lines.append("  %s -> %s pesan" % (uid, lim_str))
                    Answer("\n".join(lines), stype, source, disp)
                return

            if len(args) < 3:
                Answer(
                    "Usage:\n"
                    "aiset ulimit <jid/nick> <angka>|reset\n"
                    "aiset ulimit list\n\n"
                    "Auto limit by access:\n"
                    "  Access 1-2 -> 30 pesan\n"
                    "  Access 3-4 -> 50 pesan\n"
                    "  Access 5-6 -> 70 pesan\n"
                    "  Access 7   -> 90 pesan\n"
                    "  Access 8   -> unlimited",
                    stype, source, disp
                )
                return

            target  = args[1]
            val_str = args[2].lower()
            jid, display = self._resolve_target(target, source)

            if val_str == "reset":
                removed = self._ulimit.pop(jid, None)
                if removed is not None:
                    Answer("Custom limit %s dihapus (kembali ke auto)." % display, stype, source, disp)
                else:
                    Answer("%s tidak punya custom limit." % display, stype, source, disp)
            else:
                try:
                    val = int(val_str)
                    if val < 1:
                        raise ValueError
                    self._ulimit[jid] = val
                    Answer("Custom limit %s -> %d pesan." % (display, val), stype, source, disp)
                except ValueError:
                    Answer("Nilai harus angka positif.", stype, source, disp)

        # -- reset --------------------------------------------------------
        elif cmd == "reset":
            if sub == "all":
                total = len(self._history)
                self._reset_all_history()
                Answer("History semua user dihapus. (%d user)" % total, stype, source, disp)
            else:
                Answer("Gunakan: aiset reset all", stype, source, disp)

        # -- info ---------------------------------------------------------
        elif cmd == "info":
            status       = "ON" if self._ai_enabled else "OFF"
            ollama_str   = "running" if self._ping_ollama() else "tidak running"
            total_users  = sum(1 for k in self._history if not k.startswith("room:"))
            total_rooms  = sum(1 for k in self._history if k.startswith("room:"))
            total_msgs   = sum(len(v) for v in self._history.values()) // 2
            ulimit_count = len(self._ulimit)
            disabled_str = (
                "\n".join("  - %s" % r for r in sorted(self._disabled_rooms))
                if self._disabled_rooms else "  (tidak ada)"
            )
            room_str = ""
            if self._is_room(stype):
                room_str = "\nRoom ini : %s" % (
                    "OFF" if source[1] in self._disabled_rooms else "ON"
                )
            Answer(
                "[Nexsus] AI Info v6.3\n"
                "Global  : %s\n"
                "Ollama  : %s\n"
                "Model   : %s (%s)%s\n"
                "Users   : %d user, %d room\n"
                "Pesan   : %d total\n"
                "Ulimit  : %d custom\n"
                "Host    : %s\n\n"
                "Room OFF:\n%s\n\n"
                "Models:\n"
                "  fast  -> %s\n"
                "  smart -> %s\n\n"
                "Commands:\n"
                "ai <pertanyaan> | ai reset\n"
                "aiset on|off [global]\n"
                "aiset model fast|smart\n"
                "aiset ulimit <jid/nick> <val>|reset\n"
                "aiset ulimit list\n"
                "aiset reset all\n"
                "aiset history save|load|info\n"
                "aiset ping\n"
                "aiset info" % (
                    status,
                    ollama_str,
                    self._get_label(),
                    self._current_model,
                    room_str,
                    total_users,
                    total_rooms,
                    total_msgs,
                    ulimit_count,
                    OLLAMA_URL,
                    disabled_str,
                    OLLAMA_MODELS["fast"],
                    OLLAMA_MODELS["smart"],
                ),
                stype, source, disp
            )

        # -- history ------------------------------------------------------
        elif cmd == "history":
            if sub == "save":
                self._save_history()
                self._save_ulimit()
                Answer("[Nexsus] History & ulimit disimpan ke disk.", stype, source, disp)
            elif sub == "load":
                self._load_history()
                self._load_ulimit()
                Answer(
                    "[Nexsus] History dimuat ulang dari disk. (%d key)" % len(self._history),
                    stype, source, disp
                )
            elif sub == "info":
                import os
                h_size = os.path.getsize(HISTORY_FILE) if os.path.exists(HISTORY_FILE) else 0
                u_size = os.path.getsize(ULIMIT_FILE)  if os.path.exists(ULIMIT_FILE)  else 0
                total_users = len(self._history)
                total_msgs  = sum(len(v) for v in self._history.values()) // 2
                room_keys   = sum(1 for k in self._history if k.startswith("room:"))
                user_keys   = total_users - room_keys
                Answer(
                    "[Nexsus] History Info\n"
                    "Dir     : %s\n"
                    "File    : %.1f KB (history) / %.1f KB (ulimit)\n"
                    "Keys    : %d user, %d room\n"
                    "Pesan   : %d total\n"
                    "Dirty   : %s\n"
                    "Flush   : tiap %d detik\n"
                    "Max age : %d hari" % (
                        HISTORY_DIR,
                        h_size / 1024,
                        u_size / 1024,
                        user_keys,
                        room_keys,
                        total_msgs,
                        "ya (belum disave)" if self._dirty else "tidak",
                        HISTORY_FLUSH_INTERVAL,
                        HISTORY_MAX_AGE,
                    ),
                    stype, source, disp
                )
            elif sub == "clear":
                import os
                # hapus RAM
                total_ram = len(self._history)
                self._reset_all_history()
                # hapus file disk
                removed = []
                for f in (HISTORY_FILE, ULIMIT_FILE):
                    if os.path.exists(f):
                        os.remove(f)
                        removed.append(os.path.basename(f))
                self._dirty = False
                Answer(
                    "[Nexsus] History dihapus.\n"
                    "RAM    : %d key dihapus\n"
                    "Disk   : %s" % (
                        total_ram,
                        ", ".join(removed) if removed else "tidak ada file",
                    ),
                    stype, source, disp
                )
            else:
                Answer(
                    "Usage: aiset history save|load|clear|info",
                    stype, source, disp
                )

        # -- ping --------------------------------------------------------
        elif cmd == "ping":
            def _do_ping():
                ok = self._ping_ollama()
                if ok:
                    Answer(
                        "[Nexsus] Ollama running. AI %s." % (
                            "sudah aktif" if self._ai_enabled else "diaktifkan"
                        ),
                        stype, source, disp
                    )
                    self._ai_enabled = True
                else:
                    Answer(
                        "[Nexsus] Ollama tidak running. AI dinonaktifkan.",
                        stype, source, disp
                    )
                    self._ai_enabled = False
            threading.Thread(target=_do_ping, daemon=True).start()

        else:
            Answer(
                "Usage: aiset on|off [global] | model fast|smart | "
                "ulimit <jid/nick> <val>|reset | ulimit list | "
                "reset all | history save|load|info | ping | info",
                stype, source, disp
            )

    commands = (
        (command_ai,    "ai",    1,),
        (command_aiset, "aiset", 7,),
    )

    handlers = (
        (ai_01eh, "01eh"),
    )
