# NexsusBot Expansion — Ollama AI
# exp_name = "ai" # /code.py v.2.0

import urllib.request
import urllib.error
import json
import threading

OLLAMA_URL = "http://localhost:11434/api/chat"
OLLAMA_MODEL_DEFAULT = "qwen2:0.5b"
OLLAMA_MODELS = {
    "fast":  "qwen2:0.5b",
    "smart": "qwen2.5:3b",
}
TIMEOUT = 45

SYSTEM_PROMPT = (
    "Nama kamu adalah Nexsus, asisten bot XMPP yang tanguh. "
    "Kamu helpful, cerdas, dan ramah. "
    "Jawab dalam bahasa yang sama dengan pertanyaan pengguna. "
    "Jawaban ringkas namun lengkap, maksimal 3-4 kalimat. "
    "Gunakan bahasa santai dan friendly, boleh pakai emoji sesekali. "
    "Tolak dengan sopan jika ada pertanyaan mengandung konten negatif, sara, atau berbahaya. "

    "Kamu berada di grup chat XMPP komunitas Indonesia. "
    "Alamat grup: indonesia@conference.conversations.im. "
    "Bahasa yang digunakan campur: Indonesia, Jawa/daerah, dan Inggris — ikuti bahasa pengguna. "

    "Topik yang sering dibahas: teknologi, Linux, server, XMPP, bot, programming, dan ngobrol santai. "

    "Rules grup: dilarang spam, jaga sopan santun, no SARA, no konten berbahaya. "
    "Tegur dengan sopan jika ada yang melanggar rules. "

    "Member aktif di grup: i_duthe, bedjo, heper, 33777, IndonesianLad, Irfan, Kitsune, "
    "ivy, kujawek, mrdoctorwho, Nawan, potential suicide, Rio, tfox, uira.pro, win., "
    "ρaijo, MBG, RI.21#menlu, SPPG. "
    "paijo adalah kakak saya :D "
    "Nexsus adalah nama kamu sendiri (bot). "

    "Jika ada yang bertanya tentang grup, kamu bisa jelaskan info di atas. "
    "Jika ada yang bertanya siapa member aktif, sebutkan daftar di atas. "
)


class expansion_temp(expansion):

    def __init__(self, name):
        expansion.__init__(self, name)
        self._ai_enabled = True
        self._current_model = OLLAMA_MODEL_DEFAULT

    def _get_label(self):
        for label, model in OLLAMA_MODELS.items():
            if model == self._current_model:
                return label
        return "custom"

    def _call_ollama(self, prompt):
        """Panggil Ollama API, return (result, error)."""
        payload = json.dumps({
            "model": self._current_model,
            "messages": [
                {"role": "system", "content": SYSTEM_PROMPT},
                {"role": "user",   "content": prompt},
            ],
            "stream": False,
        }).encode("utf-8")

        req = urllib.request.Request(
            OLLAMA_URL,
            data=payload,
            headers={"Content-Type": "application/json"},
            method="POST",
        )
        try:
            with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
                data = json.loads(resp.read().decode("utf-8"))
            result = data["message"]["content"].strip()
            if len(result) > 1500:
                result = result[:1497] + "..."
            return result, None
        except urllib.error.URLError as e:
            return None, "Tidak bisa terhubung ke Ollama: %s" % e.reason
        except Exception as e:
            return None, "Error: %s" % str(e)

    def _ai_worker(self, prompt, stype, source, disp):
        """Jalankan request Ollama di thread terpisah agar bot tidak freeze."""
        result, error = self._call_ollama(prompt)
        if error:
            Answer("❌ %s" % error, stype, source, disp)
        else:
            Answer("🤖 %s" % result, stype, source, disp)

    def command_ai(self, stype, source, body, disp):
        """/ai <pertanyaan> — Tanya AI"""
        if not self._ai_enabled:
            Answer("🔴 Fitur AI sedang dinonaktifkan.", stype, source, disp)
            return
        if not body:
            Answer(
                "🤖 Ollama AI siap! (%s — %s)\n"
                "Gunakan: /ai <pertanyaan>" % (self._get_label(), self._current_model),
                stype, source, disp
            )
            return
        Answer("🦙 Sedang berpikir... (%s)" % self._current_model, stype, source, disp)
        t = threading.Thread(
            target=self._ai_worker,
            args=(body, stype, source, disp),
            daemon=True,
        )
        t.start()

    def command_aiset(self, stype, source, body, disp):
        """/aiset on|off|info|model — Kelola AI"""
        args = (body or "").strip().split()
        cmd  = args[0].lower() if args else "info"

        if cmd == "on":
            self._ai_enabled = True
            Answer("🟢 AI diaktifkan.", stype, source, disp)

        elif cmd == "off":
            self._ai_enabled = False
            Answer("🔴 AI dinonaktifkan.", stype, source, disp)

        elif cmd == "model":
            if len(args) < 2:
                Answer(
                    "🤖 Model saat ini: %s (%s)\n"
                    "Ganti: /aiset model fast|smart\n"
                    "  fast  → %s\n"
                    "  smart → %s" % (
                        self._get_label(),
                        self._current_model,
                        OLLAMA_MODELS["fast"],
                        OLLAMA_MODELS["smart"],
                    ),
                    stype, source, disp
                )
                return
            choice = args[1].lower()
            if choice in OLLAMA_MODELS:
                self._current_model = OLLAMA_MODELS[choice]
                Answer(
                    "✅ Model diganti ke: %s (%s)" % (choice, self._current_model),
                    stype, source, disp
                )
            else:
                Answer(
                    "❌ Pilihan tidak valid.\n"
                    "Gunakan: fast (%s) | smart (%s)" % (
                        OLLAMA_MODELS["fast"],
                        OLLAMA_MODELS["smart"],
                    ),
                    stype, source, disp
                )

        elif cmd == "info":
            status = "🟢 ON" if self._ai_enabled else "🔴 OFF"
            Answer(
                "🤖 AI Info\n"
                "Status : %s\n"
                "Model  : %s (%s)\n"
                "Host   : %s\n\n"
                "Models tersedia:\n"
                "  fast  → %s\n"
                "  smart → %s\n\n"
                "Commands:\n"
                "/aiset on|off\n"
                "/aiset model fast|smart\n"
                "/aiset info" % (
                    status,
                    self._get_label(),
                    self._current_model,
                    OLLAMA_URL,
                    OLLAMA_MODELS["fast"],
                    OLLAMA_MODELS["smart"],
                ),
                stype, source, disp
            )

        else:
            Answer(
                "Usage: /aiset on|off|info|model fast|smart",
                stype, source, disp
            )

    commands = (
        (command_ai,    "ai",    1,),
        (command_aiset, "aiset", 7,),
    )