# coding: utf-8
# Plugin: ai
# Author: paijo.ahmad@jabber.ru
# NexsusBot Expansion — Ollama + Groq AI
# exp_name = "ai" # /code.py v.7.0

import urllib.request
import urllib.error
import json
import threading
import os as _os

# ── Ollama config ───────────────────────────────────────────
OLLAMA_URL           = "http://localhost:11434/api/chat"
OLLAMA_TAGS_URL      = "http://localhost:11434/api/tags"
OLLAMA_PING_TIMEOUT  = 5
OLLAMA_MODEL_DEFAULT = "llama3.2:1b"
OLLAMA_MODELS = {
    "fast":  "llama3.2:1b",
    "smart": "qwen2.5:3b",
}

# ── Groq config ─────────────────────────────────────────────
GROQ_API_BASE    = "https://api.groq.com/openai/v1/chat/completions"
GROQ_CONFIG_FILE = _os.path.expanduser("~/.groq_config")
GROQ_MODELS = {
    "1": ("llama-3.3-70b-versatile", "Chat harian"),
    "2": ("llama-3.1-8b-instant",    "Volume tinggi"),
    "3": ("openai/gpt-oss-120b",     "Reasoning kuat"),
}
GROQ_MODEL_DEFAULT = "1"

TIMEOUT    = 60
CHUNK_SIZE = 400

# ── Persistensi history ─────────────────────────────────────
HISTORY_DIR           = _os.path.join(_os.path.dirname(_os.path.abspath(__file__)), ".nexsus_ai")
HISTORY_FILE          = _os.path.join(HISTORY_DIR, "history.json")
ULIMIT_FILE           = _os.path.join(HISTORY_DIR, "ulimit.json")
HISTORY_MAX_AGE       = 7
HISTORY_FLUSH_INTERVAL= 300

AI_VERSION  = "v7.0"
WAITING_MSG = "mohon tunggu... (nexsus:%s)"

HISTORY_BY_ACCESS = (
    (8, 9999),
    (7, 90),
    (5, 70),
    (3, 50),
    (1, 30),
    (0, 0),
)

SYSTEM_PROMPT = (
    "Kamu adalah NEXSUS BOT — asisten cerdas resmi di grup XMPP.\n"
    "Rooms   : indonesia@conference.conversations.im\n"
    "Platform: XMPP / Jabber (Conversations, Gajim, Monal, dll)\n"
    "Peran   : Moderator, Asisten Umum, Info Grup.\n"
    "Gunakan bahasa Indonesia santai, ramah, mudah dipahami. "
    "Jawaban singkat dan to the point — ini grup chat, bukan artikel blog. "
    "Jika tidak tahu, jujur bilang tidak tahu daripada mengarang.\n"
    "Bersikap seperti teman yang pintar — tidak kaku, tidak lebay, tidak asal jawab. "
    "Aktif, informatif, dan jaga suasana grup tetap kondusif.\n"
)

# ── Load Groq API key dari ~/.groq_config ───────────────────
def _load_groq_key():
    try:
        with open(GROQ_CONFIG_FILE) as f:
            for line in f:
                if line.startswith("GROQ_API_KEY="):
                    return line.split("=", 1)[1].strip().strip('"')
    except Exception:
        pass
    return ""

class expansion_temp(expansion):
    name = "ai"

    def __init__(self, name):
        expansion.__init__(self, name)
        self.name             = name
        self._lock            = threading.Lock()
        self._history         = {}
        self._ulimit          = {}
        self._dirty           = False
        self._ai_enabled      = False
        self._disabled_rooms  = set()

        # provider: "ollama" atau "groq"
        self._provider        = "ollama"

        # Ollama model
        self._current_model   = OLLAMA_MODEL_DEFAULT

        # Groq
        self._groq_key        = _load_groq_key()
        self._groq_model_key  = GROQ_MODEL_DEFAULT  # "1", "2", atau "3"

        self._ensure_dir()
        self._load_history()
        self._load_ulimit()
        self._boot_check()
        self._start_flush_loop()
        expansions[self.name] = self

    def dels(self):
        self._save_history()
        self._save_ulimit()
        if self.name in expansions:
            del expansions[self.name]

    # ── Boot ────────────────────────────────────────────────
    def _boot_check(self):
        # Coba Groq dulu jika key tersedia
        if self._groq_key:
            self._provider   = "groq"
            self._ai_enabled = True
            mid, mdesc = GROQ_MODELS[self._groq_model_key]
            print("[nexsus:ai] Groq API key found — provider=groq model=%s" % mid)
        elif self._ping_ollama():
            self._provider   = "ollama"
            self._ai_enabled = True
            print("[nexsus:ai] Ollama running — provider=ollama model=%s" % self._current_model)
        else:
            print("[nexsus:ai] WARNING: Groq key tidak ada & Ollama tidak running. AI dinonaktifkan.")

    # ── Dir / History ────────────────────────────────────────
    def _ensure_dir(self):
        _os.makedirs(HISTORY_DIR, exist_ok=True)

    def _load_history(self):
        import time
        try:
            with open(HISTORY_FILE) as f:
                raw = json.load(f)
            cutoff = time.time() - HISTORY_MAX_AGE * 86400
            self._history = {
                k: [e for e in v if e.get("ts", 0) >= cutoff]
                for k, v in raw.items()
            }
        except Exception:
            self._history = {}

    def _load_ulimit(self):
        try:
            with open(ULIMIT_FILE) as f:
                self._ulimit = json.load(f)
        except Exception:
            self._ulimit = {}

    def _save_history(self):
        try:
            with open(HISTORY_FILE, "w") as f:
                json.dump(self._history, f)
            self._dirty = False
        except Exception:
            pass

    def _save_ulimit(self):
        try:
            with open(ULIMIT_FILE, "w") as f:
                json.dump(self._ulimit, f)
        except Exception:
            pass

    def _start_flush_loop(self):
        def _loop():
            import time
            while True:
                time.sleep(HISTORY_FLUSH_INTERVAL)
                if self._dirty:
                    self._save_history()
        t = threading.Thread(target=_loop, daemon=True)
        t.start()

    # ── Helpers ──────────────────────────────────────────────
    def _ping_ollama(self):
        try:
            req = urllib.request.Request(OLLAMA_TAGS_URL)
            with urllib.request.urlopen(req, timeout=OLLAMA_PING_TIMEOUT):
                return True
        except Exception:
            return False

    def _ping_groq(self):
        return bool(self._groq_key)

    def _get_room_key(self, room_jid):
        return "room:%s" % room_jid

    def _get_room_limit(self, room_jid):
        return 20

    def _get_provider_label(self):
        if self._provider == "groq":
            mid, mdesc = GROQ_MODELS[self._groq_model_key]
            return "groq/%s" % mdesc
        else:
            for label, model in OLLAMA_MODELS.items():
                if model == self._current_model:
                    return "ollama/%s" % label
            return "ollama/custom"

    def _is_pm(self, stype):   return stype == "chat"
    def _is_room(self, stype): return stype == "groupchat"

    def _get_user_id(self, source):
        return str(source[0]) if source else "unknown"

    def _get_access(self, stype, source):
        try:
            return GetAccess(stype, source)
        except Exception:
            return 1

    def _get_history_limit(self, stype, source):
        user_id = self._get_user_id(source)
        if user_id in self._ulimit:
            return self._ulimit[user_id]
        acc = self._get_access(stype, source)
        for threshold, limit in HISTORY_BY_ACCESS:
            if acc >= threshold:
                return limit
        return 0

    def _check_pm_access(self, source):
        return self._get_access("chat", source) >= 1

    def _is_ai_allowed(self, stype, source):
        if not self._ai_enabled:
            return False
        if self._get_history_limit(stype, source) == 0:
            return False
        return True

    def _get_history(self, user_id):
        return self._history.get(user_id, [])

    def _add_history(self, user_id, role, content, limit):
        import time
        with self._lock:
            h = self._history.setdefault(user_id, [])
            h.append({"role": role, "content": content, "ts": time.time()})
            if limit < 9999:
                max_entries = limit * 2
                if len(h) > max_entries:
                    self._history[user_id] = h[-max_entries:]
            self._dirty = True

    def _reset_history(self, user_id):
        with self._lock:
            self._history.pop(user_id, None)
            self._dirty = True

    def _reset_all_history(self):
        with self._lock:
            self._history.clear()
            self._dirty = True

    def _resolve_target(self, target, source):
        jid = target
        display = target
        return jid, display

    # ── Ollama call ──────────────────────────────────────────
    def _call_ollama(self, user_id, prompt, limit):
        if len(prompt) > 800:
            prompt = prompt[:800] + "..."
        with self._lock:
            history = list(self._get_history(user_id))
        clean_history = [{"role": e["role"], "content": e["content"]} for e in history]
        messages = [{"role": "system", "content": SYSTEM_PROMPT}]
        messages += clean_history
        messages.append({"role": "user", "content": prompt})
        payload = json.dumps({
            "model":   self._current_model,
            "messages": messages,
            "stream":  False,
            "options": {
                "num_predict":    -1,
                "temperature":    0.7,
                "num_ctx":        2048,
                "num_thread":     5,
                "repeat_penalty": 1.1,
            },
        }).encode("utf-8")
        req = urllib.request.Request(
            OLLAMA_URL,
            data=payload,
            headers={"Content-Type": "application/json"},
            method="POST",
        )
        try:
            with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
                data = json.loads(resp.read().decode("utf-8"))
            result = data["message"]["content"].strip()
            result = "".join(c for c in result if c >= " " or c in "\n\t")
            if len(result) > 1500:
                result = result[:1497] + "..."
            if not result:
                return None, "Model tidak menghasilkan respons."
            self._add_history(user_id, "user",      prompt, limit)
            self._add_history(user_id, "assistant", result, limit)
            return result, None
        except MemoryError:
            return None, "Memory tidak cukup. Coba ganti ke model fast."
        except urllib.error.URLError as e:
            return None, "Tidak bisa terhubung ke Ollama: %s" % e.reason
        except Exception as e:
            return None, "Error: %s" % str(e)

    # ── Groq call ────────────────────────────────────────────
    def _call_groq(self, user_id, prompt, limit):
        if not self._groq_key:
            return None, "Groq API key belum diset. Jalankan ~/groq.sh setkey"
        if len(prompt) > 1200:
            prompt = prompt[:1200] + "..."
        with self._lock:
            history = list(self._get_history(user_id))
        clean_history = [{"role": e["role"], "content": e["content"]} for e in history]
        messages = [{"role": "system", "content": SYSTEM_PROMPT}]
        messages += clean_history
        messages.append({"role": "user", "content": prompt})

        model_id, _ = GROQ_MODELS[self._groq_model_key]
        payload = json.dumps({
            "model":       model_id,
            "messages":    messages,
            "max_tokens":  800,
            "temperature": 0.7,
            "stream":      False,
        }).encode("utf-8")
        req = urllib.request.Request(
            GROQ_API_BASE,
            data=payload,
            headers={
                "Content-Type":  "application/json",
                "Authorization": "Bearer %s" % self._groq_key,
            },
            method="POST",
        )
        try:
            with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
                data = json.loads(resp.read().decode("utf-8"))
            if "error" in data:
                return None, "Groq error: %s" % data["error"].get("message", "unknown")
            result = data["choices"][0]["message"]["content"].strip()
            result = "".join(c for c in result if c >= " " or c in "\n\t")
            if len(result) > 1500:
                result = result[:1497] + "..."
            if not result:
                return None, "Groq tidak menghasilkan respons."
            self._add_history(user_id, "user",      prompt, limit)
            self._add_history(user_id, "assistant", result, limit)
            return result, None
        except urllib.error.HTTPError as e:
            body = e.read().decode("utf-8", errors="replace")
            try:
                msg = json.loads(body)["error"]["message"]
            except Exception:
                msg = body[:200]
            return None, "Groq HTTP %d: %s" % (e.code, msg)
        except urllib.error.URLError as e:
            return None, "Tidak bisa terhubung ke Groq: %s" % e.reason
        except Exception as e:
            return None, "Error: %s" % str(e)

    # ── Dispatch ke provider aktif ───────────────────────────
    def _call_ai(self, user_id, prompt, limit):
        if self._provider == "groq":
            return self._call_groq(user_id, prompt, limit)
        else:
            return self._call_ollama(user_id, prompt, limit)

    # ── Chunked sender ───────────────────────────────────────
    def _send_chunked(self, text, stype, source, disp):
        import time
        if len(text) <= CHUNK_SIZE:
            Answer(text, stype, source, disp)
            return
        words  = text.split()
        chunks = []
        cur    = ""
        for w in words:
            if len(cur) + len(w) + 1 > CHUNK_SIZE:
                chunks.append(cur.strip())
                cur = w
            else:
                cur = (cur + " " + w).strip() if cur else w
        if cur:
            chunks.append(cur.strip())
        total = len(chunks)
        for i, chunk in enumerate(chunks, 1):
            Answer("(%d/%d) %s" % (i, total, chunk), stype, source, disp)
            if i < total:
                time.sleep(0.8)

    # ── AI worker (thread) ───────────────────────────────────
    def _ai_worker(self, user_id, prompt, limit, stype, source, disp,
                   room_key=None, nick=None):
        result, err = self._call_ai(user_id, prompt, limit)
        if err:
            Answer("[Nexsus] %s" % err, stype, source, disp)
            return
        if room_key:
            self._add_history(room_key, "user",      "%s: %s" % (nick or user_id, prompt), 20)
            self._add_history(room_key, "assistant", result, 20)
        self._send_chunked(result, stype, source, disp)

    # ── /ai command ──────────────────────────────────────────
    def command_ai(self, stype, source, body, disp):
        """/ai <pertanyaan> | reset"""
        if self._is_pm(stype) and not self._check_pm_access(source):
            return
        if self._is_room(stype) and source[1] in self._disabled_rooms:
            return
        if not self._ai_enabled:
            Answer("AI sedang dinonaktifkan.", stype, source, disp)
            return

        user_id = self._get_user_id(source)
        limit   = self._get_history_limit(stype, source)
        cmd     = (body or "").strip()

        if cmd.lower() == "reset":
            self._reset_history(user_id)
            Answer("History percakapanmu telah dihapus.", stype, source, disp)
            return

        if not cmd:
            history_count = len(self._get_history(user_id)) // 2
            limit_str     = "unlimited" if limit >= 9999 else str(limit)
            Answer(
                "[Nexsus] AI siap! (%s)\n"
                "Provider: %s\n"
                "History : %d/%s pesan\n"
                "Gunakan : ai <pertanyaan>\n"
                "Reset   : ai reset" % (
                    AI_VERSION,
                    self._get_provider_label(),
                    history_count,
                    limit_str,
                ),
                stype, source, disp
            )
            return

        Answer(WAITING_MSG % AI_VERSION, stype, source, disp)
        t = threading.Thread(
            target=self._ai_worker,
            args=(user_id, cmd, limit, stype, source, disp),
            daemon=True,
        )
        t.start()

    # ── mention handler ──────────────────────────────────────
    def ai_01eh(self, stanza, isConf, stype, source, body, isToBs, disp):
        if not isToBs or not isConf:
            return
        if source[1] in self._disabled_rooms:
            return
        if not self._ai_enabled:
            return
        prompt = (body or "").strip()
        if not prompt:
            return
        first_word = prompt.split()[0].lower()
        if first_word in ("ai", "aiset"):
            return
        user_id  = self._get_user_id(source)
        nick     = source[2] if source[2] else user_id
        room_jid = source[1]
        room_key = self._get_room_key(room_jid)
        limit    = self._get_room_limit(room_jid)
        Answer(WAITING_MSG % AI_VERSION, stype, source, disp)
        t = threading.Thread(
            target=self._ai_worker,
            args=(user_id, prompt, limit, stype, source, disp),
            kwargs={"room_key": room_key, "nick": nick},
            daemon=True,
        )
        t.start()

    # ── /aiset command ───────────────────────────────────────
    def command_aiset(self, stype, source, body, disp):
        """/aiset on|off|model|provider|ulimit|reset|history|ping|info"""
        args = (body or "").strip().split()
        cmd  = args[0].lower() if args else "info"
        sub  = args[1].lower() if len(args) > 1 else ""

        # -- on / off ─────────────────────────────────────────
        if cmd in ("on", "off"):
            is_on = cmd == "on"
            if sub == "global":
                self._ai_enabled = is_on
                if is_on:
                    self._disabled_rooms.clear()
                Answer("AI %s (global)." % ("diaktifkan" if is_on else "dinonaktifkan"),
                       stype, source, disp)
            elif self._is_room(stype):
                room = source[1]
                if is_on:
                    self._disabled_rooms.discard(room)
                    Answer("AI diaktifkan di room ini.", stype, source, disp)
                else:
                    self._disabled_rooms.add(room)
                    Answer("AI dinonaktifkan di room ini.", stype, source, disp)
            else:
                self._ai_enabled = is_on
                Answer("AI %s." % ("diaktifkan" if is_on else "dinonaktifkan"),
                       stype, source, disp)

        # -- provider ─────────────────────────────────────────
        elif cmd == "provider":
            if not sub:
                Answer(
                    "Provider aktif: %s\n"
                    "Ganti: aiset provider ollama|groq\n"
                    "Groq key: %s" % (
                        self._provider,
                        "tersedia" if self._groq_key else "BELUM DISET (~/groq.sh setkey)",
                    ),
                    stype, source, disp
                )
            elif sub == "groq":
                if not self._groq_key:
                    Answer("Groq key belum diset. Jalankan: ~/groq.sh setkey", stype, source, disp)
                    return
                self._provider = "groq"
                mid, mdesc = GROQ_MODELS[self._groq_model_key]
                Answer("Provider → groq\nModel: %s (%s)" % (mdesc, mid), stype, source, disp)
            elif sub == "ollama":
                if not self._ping_ollama():
                    Answer("Ollama tidak running. Jalankan: ~/ollama.sh start", stype, source, disp)
                    return
                self._provider = "ollama"
                Answer("Provider → ollama\nModel: %s" % self._current_model, stype, source, disp)
            else:
                Answer("Pilihan: ollama | groq", stype, source, disp)

        # -- model ────────────────────────────────────────────
        elif cmd == "model":
            if self._provider == "groq":
                if not sub:
                    lines = ["Model Groq (provider aktif):"]
                    for k, (mid, mdesc) in GROQ_MODELS.items():
                        marker = "▶" if k == self._groq_model_key else " "
                        lines.append("%s %s) %s — %s" % (marker, k, mdesc, mid))
                    lines.append("Ganti: aiset model 1|2|3")
                    Answer("\n".join(lines), stype, source, disp)
                elif sub in GROQ_MODELS:
                    self._groq_model_key = sub
                    mid, mdesc = GROQ_MODELS[sub]
                    Answer("Model Groq → %s\n%s" % (mdesc, mid), stype, source, disp)
                else:
                    Answer("Pilihan Groq: 1 | 2 | 3", stype, source, disp)
            else:
                if not sub:
                    Answer(
                        "Model Ollama saat ini: %s\n"
                        "Ganti: aiset model fast|smart\n"
                        "  fast  -> %s\n"
                        "  smart -> %s" % (
                            self._current_model,
                            OLLAMA_MODELS["fast"],
                            OLLAMA_MODELS["smart"],
                        ),
                        stype, source, disp
                    )
                elif sub in OLLAMA_MODELS:
                    self._current_model = OLLAMA_MODELS[sub]
                    Answer("Model Ollama → %s (%s)" % (sub, self._current_model),
                           stype, source, disp)
                else:
                    Answer("Pilihan Ollama: fast | smart", stype, source, disp)

        # -- ulimit ───────────────────────────────────────────
        elif cmd == "ulimit":
            if sub == "list":
                if not self._ulimit:
                    Answer("Tidak ada custom limit.", stype, source, disp)
                else:
                    lines = ["Custom history limit:"]
                    for uid, lim in sorted(self._ulimit.items()):
                        lines.append("  %s -> %s" % (uid, "unlimited" if lim >= 9999 else str(lim)))
                    Answer("\n".join(lines), stype, source, disp)
                return
            if len(args) < 3:
                Answer(
                    "Usage: aiset ulimit <jid/nick> <angka>|reset\n"
                    "       aiset ulimit list",
                    stype, source, disp
                )
                return
            target  = args[1]
            val_str = args[2].lower()
            jid, display = self._resolve_target(target, source)
            if val_str == "reset":
                removed = self._ulimit.pop(jid, None)
                Answer(
                    "Custom limit %s dihapus." % display if removed is not None
                    else "%s tidak punya custom limit." % display,
                    stype, source, disp
                )
            else:
                try:
                    val = int(val_str)
                    if val < 1:
                        raise ValueError
                    self._ulimit[jid] = val
                    Answer("Custom limit %s -> %d pesan." % (display, val), stype, source, disp)
                except ValueError:
                    Answer("Nilai harus angka positif.", stype, source, disp)

        # -- reset ────────────────────────────────────────────
        elif cmd == "reset":
            if sub == "all":
                total = len(self._history)
                self._reset_all_history()
                Answer("History semua user dihapus. (%d user)" % total, stype, source, disp)
            else:
                Answer("Gunakan: aiset reset all", stype, source, disp)

        # -- info ─────────────────────────────────────────────
        elif cmd == "info":
            total_users = sum(1 for k in self._history if not k.startswith("room:"))
            total_rooms = sum(1 for k in self._history if k.startswith("room:"))
            total_msgs  = sum(len(v) for v in self._history.values()) // 2
            groq_status = "key OK" if self._groq_key else "key BELUM DISET"
            ollama_status = "running" if self._ping_ollama() else "tidak running"
            room_str = ""
            if self._is_room(stype):
                room_str = "\nRoom ini : %s" % (
                    "OFF" if source[1] in self._disabled_rooms else "ON"
                )
            # model info
            if self._provider == "groq":
                mid, mdesc = GROQ_MODELS[self._groq_model_key]
                model_str = "groq/%s (%s)" % (mdesc, mid)
            else:
                model_str = "ollama/%s (%s)" % (self._current_model, self._current_model)

            Answer(
                "[Nexsus] AI Info %s\n"
                "Global  : %s\n"
                "Provider: %s\n"
                "Model   : %s%s\n"
                "Ollama  : %s\n"
                "Groq    : %s\n"
                "Users   : %d user, %d room\n"
                "Pesan   : %d total\n"
                "Ulimit  : %d custom\n\n"
                "Commands:\n"
                "ai <pertanyaan> | ai reset\n"
                "aiset on|off [global]\n"
                "aiset provider ollama|groq\n"
                "aiset model [fast|smart] (ollama)\n"
                "aiset model [1|2|3] (groq)\n"
                "aiset ulimit <jid> <val>|reset|list\n"
                "aiset reset all\n"
                "aiset history save|load|info|clear\n"
                "aiset ping | aiset info" % (
                    AI_VERSION,
                    "ON" if self._ai_enabled else "OFF",
                    self._provider,
                    model_str,
                    room_str,
                    ollama_status,
                    groq_status,
                    total_users,
                    total_rooms,
                    total_msgs,
                    len(self._ulimit),
                ),
                stype, source, disp
            )

        # -- history ──────────────────────────────────────────
        elif cmd == "history":
            if sub == "save":
                self._save_history()
                self._save_ulimit()
                Answer("History & ulimit disimpan.", stype, source, disp)
            elif sub == "load":
                self._load_history()
                self._load_ulimit()
                Answer("History dimuat ulang. (%d key)" % len(self._history), stype, source, disp)
            elif sub == "info":
                h_size = _os.path.getsize(HISTORY_FILE) if _os.path.exists(HISTORY_FILE) else 0
                u_size = _os.path.getsize(ULIMIT_FILE)  if _os.path.exists(ULIMIT_FILE)  else 0
                Answer(
                    "History Info\n"
                    "Dir  : %s\n"
                    "Size : %.1f KB / %.1f KB\n"
                    "Keys : %d user, %d room\n"
                    "Msg  : %d total" % (
                        HISTORY_DIR,
                        h_size / 1024,
                        u_size / 1024,
                        sum(1 for k in self._history if not k.startswith("room:")),
                        sum(1 for k in self._history if k.startswith("room:")),
                        sum(len(v) for v in self._history.values()) // 2,
                    ),
                    stype, source, disp
                )
            elif sub == "clear":
                total_ram = len(self._history)
                self._reset_all_history()
                removed = []
                for f in (HISTORY_FILE, ULIMIT_FILE):
                    if _os.path.exists(f):
                        _os.remove(f)
                        removed.append(_os.path.basename(f))
                self._dirty = False
                Answer(
                    "History dihapus.\nRAM: %d key\nDisk: %s" % (
                        total_ram,
                        ", ".join(removed) if removed else "tidak ada file",
                    ),
                    stype, source, disp
                )
            else:
                Answer("Usage: aiset history save|load|info|clear", stype, source, disp)

        # -- ping ─────────────────────────────────────────────
        elif cmd == "ping":
            def _do_ping():
                lines = []
                # Groq
                if self._groq_key:
                    lines.append("Groq   : key OK")
                else:
                    lines.append("Groq   : key belum diset")
                # Ollama
                if self._ping_ollama():
                    lines.append("Ollama : running")
                else:
                    lines.append("Ollama : tidak running")
                lines.append("Provider aktif: %s" % self._provider)
                Answer("\n".join(lines), stype, source, disp)
            threading.Thread(target=_do_ping, daemon=True).start()

        # -- reload key ───────────────────────────────────────
        elif cmd == "reloadkey":
            self._groq_key = _load_groq_key()
            Answer(
                "Groq key di-reload: %s" % (
                    "OK (%s...)" % self._groq_key[:8] if self._groq_key else "TIDAK DITEMUKAN"
                ),
                stype, source, disp
            )

        else:
            Answer(
                "Usage: aiset on|off [global] | provider ollama|groq | "
                "model | ulimit | reset all | history | ping | reloadkey | info",
                stype, source, disp
            )

    commands = (
        (command_ai,    "ai",    1,),
        (command_aiset, "aiset", 7,),
    )

    handlers = (
        (ai_01eh, "01eh"),
    )
