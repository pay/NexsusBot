    "Kamu berada di grup chat XMPP komunitas Indonesia. "
    "Alamat grup: indonesia@conference.conversations.im. "
    "Bahasa yang digunakan campur: Indonesia, Jawa/daerah, dan Inggris — ikuti bahasa pengguna. "
    "Topik yang sering dibahas: teknologi, Linux, server, XMPP, bot, programming, dan ngobrol santai. "
    "Rules grup: dilarang spam, jaga sopan santun, no SARA, no konten berbahaya. "
    "Tegur dengan sopan jika ada yang melanggar rules. "
    "Member aktif di grup: i_duthe, bedjo, heper, 33777, IndonesianLad, Irfan, Kitsune, "
    "ivy, kujawek, mrdoctorwho, Nawan, potential suicide, Rio, tfox, uira.pro, win., "
    "paijo, MBG, RI.21#menlu, SPPG. "
    "paijo adalah kakak kamu. "
    "Nexsus adalah nama kamu sendiri (bot). "
    "Jika ada yang bertanya tentang grup, kamu bisa jelaskan info di atas. "
    "Jika ada yang bertanya siapa member aktif, sebutkan daftar di atas. "
)


class expansion_temp(expansion):

    def __init__(self, name):
        expansion.__init__(self, name)
        self._ai_enabled     = False
        self._disabled_rooms = set()
        self._current_model  = OLLAMA_MODEL_DEFAULT
        self._history        = {}
        self._ulimit         = {}
        self._lock           = threading.Lock()
        # cek Ollama saat boot (non-blocking)
        t = threading.Thread(target=self._boot_check, daemon=True)
        t.start()

    # -- boot check -------------------------------------------------------

    def _ping_ollama(self):
        """Ping Ollama /api/tags, return True jika running."""
        try:
            req = urllib.request.Request(
                OLLAMA_TAGS_URL,
                headers={"Content-Type": "application/json"},
                method="GET",
            )
            with urllib.request.urlopen(req, timeout=OLLAMA_PING_TIMEOUT) as resp:
                return resp.status == 200
        except Exception:
            return False

    def _boot_check(self):
        """Jalankan saat boot: aktifkan AI jika Ollama running."""
        if self._ping_ollama():
            self._ai_enabled = True
            print("[nexsus:ai] Ollama running — AI diaktifkan (%s)" % self._current_model)
        else:
            print("[nexsus:ai] Ollama tidak running — AI dinonaktifkan")

    # -- helpers ----------------------------------------------------------

    def _get_label(self):
        for label, model in OLLAMA_MODELS.items():
            if model == self._current_model:
                return label
        return "custom"

    def _is_pm(self, stype):
        return stype == sBase[0]

    def _is_room(self, stype):
        return stype == sBase[1]

    def _get_user_id(self, source):
        return source[2] if source[2] else source[1]

    def _get_access(self, stype, source):
        if self._is_pm(stype):
            return Galist.get(source[1].lower(), 2)
        return get_access(source[1], source[2])

    def _get_history_limit(self, stype, source):
        user_id = self._get_user_id(source)
        if user_id in self._ulimit:
            return self._ulimit[user_id]
        if self._is_pm(stype):
            jid = source[1].lower()
            if jid != user_id and jid in self._ulimit:
                return self._ulimit[jid]
        access = self._get_access(stype, source)
        for min_access, limit in HISTORY_BY_ACCESS:
            if access >= min_access:
                return limit
        return 0

    def _check_pm_access(self, source):
        return Galist.get(source[1].lower(), 0) >= 7

    def _is_ai_allowed(self, stype, source):
        if not self._ai_enabled:
            return False
        if self._is_pm(stype):
            return self._check_pm_access(source)
        if self._is_room(stype):
            return source[1] not in self._disabled_rooms
        return True

    # -- history ----------------------------------------------------------

    def _get_history(self, user_id):
        return self._history.setdefault(user_id, [])

    def _add_history(self, user_id, role, content, limit):
        with self._lock:
            history = self._get_history(user_id)
            history.append({"role": role, "content": content})
            if limit < 9999:
                max_msgs = limit * 2
                if len(history) > max_msgs:
                    self._history[user_id] = history[-max_msgs:]

    def _reset_history(self, user_id):
        with self._lock:
            self._history[user_id] = []

    def _reset_all_history(self):
        with self._lock:
            self._history = {}

    # -- resolve nick/jid untuk ulimit ------------------------------------

    def _resolve_target(self, target, source):
        room = source[1]
        if room in Chats:
            user = Chats[room].get_user(target)
            if user and user.source:
                return user.source.lower(), target
        for conf_str, conf in Chats.items():
            user = conf.get_user(target)
            if user and user.source:
                return user.source.lower(), target
        return target.lower(), target

    # -- ollama -----------------------------------------------------------

    def _call_ollama(self, user_id, prompt, limit):
        # batasi panjang prompt agar tidak OOM di Termux
        if len(prompt) > 800:
            prompt = prompt[:800] + "..."

        with self._lock:
            history = list(self._get_history(user_id))
        messages = [{"role": "system", "content": SYSTEM_PROMPT}]
        messages += history
        messages.append({"role": "user", "content": prompt})

        payload = json.dumps({
            "model":    self._current_model,
            "messages": messages,
            "stream":   False,
            "options": {
                "num_predict":    200,
                "temperature":    0.7,
                "num_ctx":        512,
                "num_thread":     5,
                "repeat_penalty": 1.1,
            },
        }).encode("utf-8")

        req = urllib.request.Request(
            OLLAMA_URL,
            data=payload,
            headers={"Content-Type": "application/json"},
            method="POST",
        )
        try:
            with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
                data = json.loads(resp.read().decode("utf-8"))
            result = data["message"]["content"].strip()
            # sanitasi karakter non-printable yang bisa crash XMPP
            result = "".join(c for c in result if c >= " " or c in "\n\t")
            if len(result) > 1500:
                result = result[:1497] + "..."
            if not result:
                return None, "Model tidak menghasilkan respons."
            self._add_history(user_id, "user",      prompt, limit)
            self._add_history(user_id, "assistant", result, limit)
            return result, None
        except MemoryError:
            return None, "Memory tidak cukup untuk model ini. Coba ganti ke model fast."
        except urllib.error.URLError as e:
            return None, "Tidak bisa terhubung ke Ollama: %s" % e.reason
        except Exception as e:
            return None, "Error: %s" % str(e)

    def _ai_worker(self, user_id, prompt, limit, stype, source, disp):
        result, error = self._call_ollama(user_id, prompt, limit)
        if error:
            Answer("[Nexsus] %s" % error, stype, source, disp)
        else:
            Answer("[Nexsus] %s" % result, stype, source, disp)

    # -- /ai --------------------------------------------------------------

    def command_ai(self, stype, source, body, disp):
        """/ai <pertanyaan> | reset"""
        if self._is_pm(stype) and not self._check_pm_access(source):
            return
        if self._is_room(stype) and source[1] in self._disabled_rooms:
            return
        if not self._ai_enabled:
            Answer("AI sedang dinonaktifkan.", stype, source, disp)
            return

        user_id = self._get_user_id(source)
        limit   = self._get_history_limit(stype, source)
        cmd     = (body or "").strip()

        if cmd.lower() == "reset":
            self._reset_history(user_id)
            Answer("History percakapanmu telah dihapus.", stype, source, disp)
            return

        if not cmd:
            history_count = len(self._get_history(user_id)) // 2
            limit_str     = "unlimited" if limit >= 9999 else str(limit)
            override_str  = " (custom)" if user_id in self._ulimit else " (auto)"
            room_str      = ""
            if self._is_room(stype):
                room_str = "\nRoom ini : %s" % (
                    "OFF" if source[1] in self._disabled_rooms else "ON"
                )
            Answer(
                "[Nexsus] Ollama AI siap! (%s — %s)\n"
                "History : %d/%s pesan%s%s\n"
                "Gunakan : ai <pertanyaan>\n"
                "Reset   : ai reset" % (
                    self._get_label(),
                    self._current_model,
                    history_count,
                    limit_str,
                    override_str,
                    room_str,
                ),
                stype, source, disp
            )
            return

        Answer(WAITING_MSG % AI_VERSION, stype, source, disp)
        t = threading.Thread(
            target=self._ai_worker,
            args=(user_id, cmd, limit, stype, source, disp),
            daemon=True,
        )
        t.start()

    # -- mention handler (01eh) -------------------------------------------

    def ai_01eh(self, stanza, isConf, stype, source, body, isToBs, disp):
        """Handle mention: aibot: <pertanyaan>"""
        # hanya proses mention di room
        if not isToBs or not isConf:
            return
        # cek room off
        if source[1] in self._disabled_rooms:
            return
        # cek global
        if not self._ai_enabled:
            return
        # abaikan body kosong
        prompt = (body or "").strip()
        if not prompt:
            return
        # abaikan jika command valid (sudah dihandle command_ai)
        first_word = prompt.split()[0].lower()
        if first_word in ("ai", "aiset"):
            return

        user_id = self._get_user_id(source)
        limit   = self._get_history_limit(stype, source)

        Answer(WAITING_MSG % AI_VERSION, stype, source, disp)
        t = threading.Thread(
            target=self._ai_worker,
            args=(user_id, prompt, limit, stype, source, disp),
            daemon=True,
        )
        t.start()

    # -- /aiset -----------------------------------------------------------

    def command_aiset(self, stype, source, body, disp):
        """/aiset on|off [global]|model|ulimit|reset|info"""
        args = (body or "").strip().split()
        cmd  = args[0].lower() if args else "info"
        sub  = args[1].lower() if len(args) > 1 else ""

        # -- on / off -----------------------------------------------------
        if cmd in ("on", "off"):
            is_on = cmd == "on"
            if sub == "global":
                self._ai_enabled = is_on
                if is_on:
                    self._disabled_rooms.clear()
                Answer(
                    "AI %s (global)." % (
                        "diaktifkan semua room" if is_on else "dinonaktifkan semua room"
                    ),
                    stype, source, disp
                )
            elif self._is_room(stype):
                room = source[1]
                if is_on:
                    self._disabled_rooms.discard(room)
                    Answer("AI diaktifkan di room ini.", stype, source, disp)
                else:
                    self._disabled_rooms.add(room)
                    Answer("AI dinonaktifkan di room ini.", stype, source, disp)
            else:
                self._ai_enabled = is_on
                Answer(
                    "AI %s (global)." % ("diaktifkan" if is_on else "dinonaktifkan"),
                    stype, source, disp
                )

        # -- model --------------------------------------------------------
        elif cmd == "model":
            if not sub:
                Answer(
                    "Model saat ini: %s (%s)\n"
                    "Ganti: /aiset model fast|smart\n"
                    "  fast  -> %s\n"
                    "  smart -> %s" % (
                        self._get_label(),
                        self._current_model,
                        OLLAMA_MODELS["fast"],
                        OLLAMA_MODELS["smart"],
                    ),
                    stype, source, disp
                )
            elif sub in OLLAMA_MODELS:
                self._current_model = OLLAMA_MODELS[sub]
                Answer(
                    "Model diganti ke: %s (%s)" % (sub, self._current_model),
                    stype, source, disp
                )
            else:
                Answer(
                    "Pilihan: fast (%s) | smart (%s)" % (
                        OLLAMA_MODELS["fast"],
                        OLLAMA_MODELS["smart"],
                    ),
                    stype, source, disp
                )

        # -- ulimit -------------------------------------------------------
        elif cmd == "ulimit":
            if sub == "list":
                if not self._ulimit:
                    Answer("Tidak ada custom limit.", stype, source, disp)
                else:
                    lines = ["Custom history limit:"]
                    for uid, lim in sorted(self._ulimit.items()):
                        lim_str = "unlimited" if lim >= 9999 else str(lim)
                        lines.append("  %s -> %s pesan" % (uid, lim_str))
                    Answer("\n".join(lines), stype, source, disp)
                return

            if len(args) < 3:
                Answer(
                    "Usage:\n"
                    "aiset ulimit <jid/nick> <angka>|reset\n"
                    "aiset ulimit list\n\n"
                    "Auto limit by access:\n"
                    "  Access 1-2 -> 30 pesan\n"
                    "  Access 3-4 -> 50 pesan\n"
                    "  Access 5-6 -> 70 pesan\n"
                    "  Access 7   -> 90 pesan\n"
                    "  Access 8   -> unlimited",
                    stype, source, disp
                )
                return

            target  = args[1]
            val_str = args[2].lower()
            jid, display = self._resolve_target(target, source)

            if val_str == "reset":
                removed = self._ulimit.pop(jid, None)
                if removed is not None:
                    Answer("Custom limit %s dihapus (kembali ke auto)." % display, stype, source, disp)
                else:
                    Answer("%s tidak punya custom limit." % display, stype, source, disp)
            else:
                try:
                    val = int(val_str)
                    if val < 1:
                        raise ValueError
                    self._ulimit[jid] = val
                    Answer("Custom limit %s -> %d pesan." % (display, val), stype, source, disp)
                except ValueError:
                    Answer("Nilai harus angka positif.", stype, source, disp)

        # -- reset --------------------------------------------------------
        elif cmd == "reset":
            if sub == "all":
                total = len(self._history)
                self._reset_all_history()
                Answer("History semua user dihapus. (%d user)" % total, stype, source, disp)
            else:
                Answer("Gunakan: aiset reset all", stype, source, disp)

        # -- info ---------------------------------------------------------
        elif cmd == "info":
            status       = "ON" if self._ai_enabled else "OFF"
            ollama_str   = "running" if self._ping_ollama() else "tidak running"
            total_users  = len(self._history)
            total_msgs   = sum(len(v) for v in self._history.values()) // 2
            ulimit_count = len(self._ulimit)
            disabled_str = (
                "\n".join("  - %s" % r for r in sorted(self._disabled_rooms))
                if self._disabled_rooms else "  (tidak ada)"
            )
            room_str = ""
            if self._is_room(stype):
                room_str = "\nRoom ini : %s" % (
                    "OFF" if source[1] in self._disabled_rooms else "ON"
                )
            Answer(
                "[Nexsus] AI Info v6.2\n"
                "Global  : %s\n"
                "Ollama  : %s\n"
                "Model   : %s (%s)%s\n"
                "Users   : %d aktif (%d total pesan)\n"
                "Ulimit  : %d custom\n"
                "Host    : %s\n\n"
                "Room OFF:\n%s\n\n"
                "Models:\n"
                "  fast  -> %s\n"
                "  smart -> %s\n\n"
                "Commands:\n"
                "ai <pertanyaan> | ai reset\n"
                "aiset on|off [global]\n"
                "aiset model fast|smart\n"
                "aiset ulimit <jid/nick> <val>|reset\n"
                "aiset ulimit list\n"
                "aiset reset all\n"
                "aiset ping\n"
                "aiset info" % (
                    status,
                    ollama_str,
                    self._get_label(),
                    self._current_model,
                    room_str,
                    total_users,
                    total_msgs,
                    ulimit_count,
                    OLLAMA_URL,
                    disabled_str,
                    OLLAMA_MODELS["fast"],
                    OLLAMA_MODELS["smart"],
                ),
                stype, source, disp
            )

        # -- ping --------------------------------------------------------
        elif cmd == "ping":
            def _do_ping():
                ok = self._ping_ollama()
                if ok:
                    Answer(
                        "[Nexsus] Ollama running. AI %s." % (
                            "sudah aktif" if self._ai_enabled else "diaktifkan"
                        ),
                        stype, source, disp
                    )
                    self._ai_enabled = True
                else:
                    Answer(
                        "[Nexsus] Ollama tidak running. AI dinonaktifkan.",
                        stype, source, disp
                    )
                    self._ai_enabled = False
            threading.Thread(target=_do_ping, daemon=True).start()

        else:
            Answer(
                "Usage: aiset on|off [global] | model fast|smart | "
                "ulimit <jid/nick> <val>|reset | ulimit list | reset all | ping | info",
                stype, source, disp
            )

    commands = (
        (command_ai,    "ai",    1,),
        (command_aiset, "aiset", 7,),
    )

    handlers = (
        (ai_01eh, "01eh"),
    )
