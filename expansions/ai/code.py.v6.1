import urllib.request
import urllib.error
import json
import threading

OLLAMA_URL           = "http://localhost:11434/api/chat"
OLLAMA_TAGS_URL      = "http://localhost:11434/api/tags"
OLLAMA_PING_TIMEOUT  = 5
OLLAMA_MODEL_DEFAULT = "llama3.2:1b"
OLLAMA_MODELS = {
    "fast":  "llama3.2:1b",
    "smart": "qwen2.5:3b",
}

TIMEOUT = 300

AI_VERSION  = "v6.2"
WAITING_MSG = "mohon tunggu... (nexsus:%s)"

# History limit by access level
HISTORY_BY_ACCESS = (
    (8, 9999),  # access 8   -> unlimited
    (7, 90),    # access 7   -> 90
    (5, 70),    # access 5-6 -> 70
    (3, 50),    # access 3-4 -> 50
    (1, 30),    # access 1-2 -> 30
    (0, 0),     # access 0   -> tidak bisa
)

SYSTEM_PROMPT = (
    "Nama kamu adalah Nexsus, XMPP Jabber Bot. "
    "Kamu helpful, cerdas, dan ramah. "
    "Jawab dalam bahasa yang sama dengan pertanyaan pengguna. "
    "Jawaban ringkas namun lengkap, maksimal 3-4 kalimat. "
    "Gunakan bahasa santai dan friendly, boleh pakai emoji sesekali. "
