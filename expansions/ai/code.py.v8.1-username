HISTORY_FLUSH_INTERVAL = 300

AI_VERSION  = "v8.1"
WAITING_MSG = "mohon tunggu... (nexsus:%s)"

HISTORY_BY_ACCESS = (
    (8, 9999),
    (7, 90),
    (5, 70),
    (3, 50),
    (1, 30),
    (0, 0),
)

